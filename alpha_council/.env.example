# --- Model/Auth ---
# Optional explicit env file path for CLI runs.
# ALPHACOUNCIL_ENV_FILE=~/secrets/alpha-council.env
ALPHACOUNCIL_ENV_FILE=

# Global model provider and model selection.
# Providers: gemini | ollama
ALPHACOUNCIL_MODEL_PROVIDER=gemini
ALPHACOUNCIL_MODEL=gemini-3.1-flash-lite

# Gemini auth: use one of the following auth methods:
# 1) Direct API key (local/dev)
# 2) Vertex AI auth in GCP runtime
GOOGLE_GENAI_USE_VERTEXAI=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
GOOGLE_API_KEY=

# Ollama local model host.
# The model should support tool calling.
# ADK recommends the ollama_chat provider under the hood.
OLLAMA_API_BASE=http://localhost:11434
# Optional auth when Ollama is exposed behind a gateway.
# Alias: OLLAMA_AUTH_TOKEN
OLLAMA_API_KEY=
# Optional Cloudflare Access headers when Ollama is behind CF Zero Trust.
OLLAMA_CF_ACCESS_CLIENT_ID=
OLLAMA_CF_ACCESS_CLIENT_SECRET=
# Optional Cloudflare Access authorization cookie value.
# Raw token only; code will send Cookie: CF_Authorization=<value>
OLLAMA_CF_AUTHORIZATION=

# Cloud Run service telemetry bucket name only, e.g. alphacouncil-agent-logs
# Do not prefix with gs://
LOGS_BUCKET_NAME=

# Optional: origins allowed by FastAPI CORS
# Leave empty when using ADK Web default frontend in development.
# Set explicit origins only for browser cross-origin calls to deployed service.
# Use semicolon to separate multiple origins, e.g.
# https://app.example.com;https://admin.example.com
ALLOW_ORIGINS=

# --- Report persistence ---
# true: write report artifact after successful run
# false: run only, do not persist report
ALPHACOUNCIL_PERSIST_ENABLED=

# Optional: write to GCS when set, e.g.
# gs://my-bucket/alphacouncil/reports
GCS_BUCKET_ROOT=

# Local fallback root when GCS_BUCKET_ROOT is empty
LOCAL_REPORT_ROOT=./reports

# Default report format when CLI flag --report-format is omitted
# Allowed: json | md
REPORT_FORMAT=json

# Max run time in seconds before timeout
ORCHESTRATOR_TIMEOUT_SECONDS=1800
